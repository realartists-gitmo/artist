// PRE-PRODUCTION POLICY: bump this ABI directly when it changes. Do not add
// compatibility worlds, legacy interfaces, or migration adapters.
package artist:plugin@0.8.0;

interface types {
    enum capability {
        prompt,
        tools,
        resources,
        context,
        hooks,
        model-config,
        model-provider,
        events,
        commands,
    }

    record plugin-descriptor {
        id: string,
        version: string,
        // Lifecycle providers run by ascending priority, then id.
        priority: s32,
        capabilities: list<capability>,
    }

    enum context-role { system, agents, profile, identity, other }
    record context-fragment {
        source: string,
        content: string,
        role: context-role,
    }

    record blob-ref {
        algorithm: string,
        digest: string,
        byte-length: u64,
        media-type: string,
        logical-name: option<string>,
    }
    record metadata-entry { key: string, value: string }
    record attachment {
        blob: blob-ref,
        role: string,
        alternate-text: option<string>,
        metadata: list<metadata-entry>,
    }
    record opaque-content { kind: string, value: string }
    variant content-part {
        text(string),
        json(string),
        attachment(attachment),
        reasoning(string),
        opaque(opaque-content),
    }
    record model-history-item {
        sequence: u64,
        message: string,
    }
    record model-context {
        context: string,
        prompt: list<content-part>,
        history: list<model-history-item>,
    }
    record compaction-artifact {
        content: list<content-part>,
        derivations: string,
        projection-digest: string,
        earliest-changed-sequence: u64,
    }

    enum tool-effect { observe, mutate, execute, session-control, unknown }
    record tool-annotations {
        read-only: bool,
        destructive: bool,
        idempotent: bool,
        open-world: bool,
    }
    record tool-definition {
        name: string,
        description: string,
        category: string,
        input-schema: string,
        output-schema: string,
        effects: list<tool-effect>,
        annotations: tool-annotations,
    }
    record next-action-hint { kind: string, label: string, payload: string }
    record field-violation { path: string, message: string }
    record tool-success {
        value: string,
        content: list<content-part>,
        next-actions: list<next-action-hint>,
    }
    record tool-failure {
        code: string,
        message: string,
        retriable: bool,
        details: string,
        violations: list<field-violation>,
        next-actions: list<next-action-hint>,
    }

    record slash-command-definition {
        name: string,
        description: string,
    }
    record profile-activation {
        profile: string,
        brief: option<string>,
    }
    variant slash-command-action {
        input(string),
        steer(string),
        abort(string),
        activate-profile(profile-activation),
    }
    record slash-command-result {
        output: option<string>,
        actions: list<slash-command-action>,
    }

    record model-config {
        provider: string,
        model: string,
        parameters: string,
    }

    enum hook-phase {
        before-model-request,
        after-model-response,
        before-tool-execution,
        after-tool-result,
        run-completed,
        run-interrupted,
        run-failed,
    }
    record invocation-scope {
        session-id: string,
        run-id: option<string>,
        call-id: option<string>,
        correlation-id: string,
        parent-correlation-id: option<string>,
    }
    record hook-event {
        phase: hook-phase,
        scope: invocation-scope,
        payload: string,
    }

    variant hook-decision {
        proceed,
        stop(string),
        rewrite(string),
    }

    enum resource-operation { read, children, write, edit, move, run, signal, poll }
    record signal-definition {
        name: string,
        description: string,
        payload-schema: string,
    }
    record resource-route {
        base-glob: string,
        projection-glob: option<string>,
        operations: list<resource-operation>,
        signals: list<signal-definition>,
    }
    record read-request { uri: string, start-line: option<u64>, line-count: option<u64> }
    record write-request { uri: string, text: string }
    record move-request { source: string, to: option<string> }
    record poll-request {
        uri: string,
        match: option<string>,
        timeout-ms: option<u64>,
        cursor: option<string>,
    }
    record environment-entry { name: string, value: string }
    record run-request {
        target: string,
        input: string,
        cwd: option<string>,
        env: list<environment-entry>,
        timeout-ms: option<u64>,
    }
    record signal-request { uri: string, name: string, payload: option<string> }
    record text-replacement { start-byte: u64, end-byte: u64, text: string }
    record edit-request {
        uri: string,
        expected-sha256: string,
        replacements: list<text-replacement>,
    }
    record replace-operation {
        start: string,
        end: option<string>,
        content: string,
    }
    record delete-operation { start: string, end: option<string> }
    record insert-operation { anchor: string, content: string }
    variant anchored-edit-operation {
        replace(replace-operation),
        delete(delete-operation),
        insert-before(insert-operation),
        insert-after(insert-operation),
    }
    record anchored-edit-request { uri: string, operations: list<anchored-edit-operation> }
    record anchored-line { line-number: u64, anchor: string, text: string }
    record anchored-read-reply {
        revision: string,
        total-lines: u64,
        lines: list<anchored-line>,
    }
    record anchored-edit-reply {
        revision: string,
        diff: string,
        updated-lines: list<anchored-line>,
        diff-truncated: bool,
        anchors-truncated: bool,
    }
    record resource-metadata {
        uri: string,
        operations: list<resource-operation>,
        signals: list<signal-definition>,
    }
    record find-request {
        uri: string,
        glob: option<string>,
        max-depth: option<u64>,
        cursor: option<string>,
        limit: option<u64>,
    }
    record grep-request {
        uri: string,
        regex: string,
        include-glob: option<string>,
        context: option<u64>,
        cursor: option<string>,
        limit: option<u64>,
    }
    variant resource-request {
        read(read-request),
        children(string),
        write(write-request),
        edit(edit-request),
        move(move-request),
        run(run-request),
        signal(signal-request),
        poll(poll-request),
    }
    enum poll-outcome { matched, closed, timed-out }
    record poll-reply { text: string, outcome: poll-outcome, next-cursor: string }
    record edited-reply { revision: string }
    variant resource-reply {
        text(string),
        content(list<content-part>),
        children(list<string>),
        written,
        edited(edited-reply),
        moved,
        started(string),
        signaled,
        poll(poll-reply),
    }
    record route-error { uri: string, operation: resource-operation }
    record conflict-error { uri: string, current-revision: string }
    variant resource-error {
        not-found(route-error),
        unsupported(route-error),
        conflict(conflict-error),
        invalid(string),
        provider(string),
    }
}

interface lifecycle {
    use types.{compaction-artifact, context-fragment, hook-decision, hook-event, model-config, model-context, plugin-descriptor};

    descriptor: func() -> plugin-descriptor;
    compose-prompt: func(fragments: list<context-fragment>) -> result<list<context-fragment>, string>;
    transform-context: func(context: model-context) -> result<model-context, string>;
    compact-context: func(context: model-context) -> result<option<compaction-artifact>, string>;
    observe-hook: func(event: hook-event) -> result<hook-decision, string>;
    configure-model: func(config: model-config) -> result<model-config, string>;
    observe-event: func(event: string) -> result<_, string>;
}

interface tool-provider {
    use types.{tool-definition, tool-failure, tool-success};
    definitions: func() -> result<list<tool-definition>, string>;
    invoke: func(name: string, arguments: string) -> result<tool-success, tool-failure>;
}

interface resource-provider {
    use types.{resource-error, resource-reply, resource-request, resource-route};
    routes: func() -> result<list<resource-route>, string>;
    handle: func(request: resource-request) -> result<resource-reply, resource-error>;
}

// Harness-facing commands. Names are global (and omit the leading slash),
// arguments are the unparsed remainder of the user's command line, and the
// typed actions are applied by the kernel after successful invocation.
interface slash-command-provider {
    use types.{slash-command-definition, slash-command-result};
    definitions: func() -> result<list<slash-command-definition>, string>;
    invoke: func(name: string, arguments: string) -> result<slash-command-result, string>;
}

interface host-tools {
    use types.{tool-definition, tool-failure, tool-success};
    list-tools: func() -> result<list<tool-definition>, string>;
    call-tool: func(name: string, arguments: string) -> result<tool-success, tool-failure>;
}

// Terminal session-control capabilities. Components define the model-facing
// verbs, while the host attaches typed control to the invocation result.
interface host-control {
    yield: func(payload: string) -> result<_, string>;
    handoff: func(profile: string, brief: string) -> result<_, string>;
}

// Generic access to the host-owned logical resource fabric. Model-facing tool
// policy and presentation belong in WASM tool-provider components; these
// imports expose only the underlying resource and indexed-search mechanics.
interface host-resources {
    use types.{anchored-edit-reply, anchored-edit-request, anchored-read-reply, find-request, grep-request, read-request, resource-error, resource-metadata, resource-reply, resource-request};
    handle: func(request: resource-request) -> result<resource-reply, resource-error>;
    read-anchored: func(request: read-request) -> result<anchored-read-reply, resource-error>;
    edit-anchored: func(request: anchored-edit-request) -> result<anchored-edit-reply, resource-error>;
    metadata: func(uri: string) -> result<resource-metadata, resource-error>;
    find: func(request: find-request) -> result<string, string>;
    grep: func(request: grep-request) -> result<string, string>;
}

// Provider-lifetime state for one logical component provider. Resource calls may run
// in separate component instances, so guest memory is request-local; this
// host-owned namespace is shared by every concurrent call from the same plugin.
interface model-provider {
    use types.{tool-failure};
    record provider-descriptor {
        provider-id: string,
        revision: string,
        model-patterns: list<string>,
        capabilities: list<string>,
        auth-kinds: list<string>,
        api-variants: list<string>,
        parameter-schema: string,
    }
    variant stream-item {
        event(string),
        finished,
        failed(tool-failure),
    }
    descriptors: func() -> result<list<provider-descriptor>, string>;
    start: func(request: string) -> result<string, tool-failure>;
    poll: func(handle: string) -> result<stream-item, tool-failure>;
    cancel: func(handle: string) -> result<_, tool-failure>;
}

interface host-progress {
    use types.{invocation-scope};
    record progress {
        scope: invocation-scope,
        sequence: u64,
        fraction: option<f64>,
        message: option<string>,
        detail: string,
    }
    emit: func(progress: progress) -> result<_, string>;
}

interface host-events {
    use types.{invocation-scope};
    record event-schema {
        schema-id: string,
        event-type: string,
        version: string,
        payload-schema: string,
        presentation-schema: string,
        presentation: string,
    }
    record event-request {
        schema-id: string,
        event-type: string,
        schema-version: string,
        schema-digest: string,
        scope: invocation-scope,
        payload: string,
        presentation: string,
        durable: bool,
    }
    register-schema: func(schema: event-schema) -> result<string, string>;
    emit: func(event: event-request) -> result<_, string>;
}

interface host-sessions {
    use types.{content-part};
    enum attachment { attached, detached }
    enum recovery-policy { remain-interrupted, resume-queued-work, plugin-resolved }
    record create-request {
        request-id: string,
        session-id: string,
        profile: string,
        content: list<content-part>,
        attachment: attachment,
        recovery: recovery-policy,
        relationship: string,
    }
    record event-page { events: list<string>, next-cursor: u64 }
    create: func(request: create-request) -> result<string, string>;
    send: func(session-id: string, content: list<content-part>) -> result<_, string>;
    steer: func(session-id: string, content: list<content-part>) -> result<_, string>;
    snapshot: func(session-id: string) -> result<string, string>;
    events: func(session-id: string, cursor: u64, limit: u32) -> result<event-page, string>;
    stop: func(session-id: string, reason: string) -> result<_, string>;
    await-terminal: func(session-id: string) -> result<string, string>;
}

interface provider-state {
    get: func(key: string) -> result<option<string>, string>;
    set: func(key: string, value: string) -> result<_, string>;
    delete: func(key: string) -> result<_, string>;
    compare-and-swap: func(key: string, expected: option<string>, value: option<string>) -> result<bool, string>;
}

interface native-filesystem {
    use types.{edit-request, resource-error};
    read: func(uri: string, start-line: option<u64>, line-count: option<u64>) -> result<string, string>;
    children: func(uri: string) -> result<list<string>, string>;
    write: func(uri: string, text: string) -> result<_, string>;
    move: func(source: string, to: option<string>) -> result<_, string>;
    edit: func(request: edit-request) -> result<string, resource-error>;
}

interface native-profiles {
    read: func(uri: string, start-line: option<u64>, line-count: option<u64>) -> result<string, string>;
    children: func(uri: string) -> result<list<string>, string>;
}

// Host-owned package mechanics. The narrow plugins resource components expose
// these operations without owning package storage or activation state.
interface native-plugins {
    use types.{edit-request, resource-error};
    read: func(uri: string, start-line: option<u64>, line-count: option<u64>) -> result<string, string>;
    children: func(uri: string) -> result<list<string>, string>;
    write: func(uri: string, text: string) -> result<_, string>;
    move: func(source: string, to: option<string>) -> result<_, string>;
    edit: func(request: edit-request) -> result<string, resource-error>;
    signal: func(uri: string, name: string, payload: option<string>) -> result<_, resource-error>;
}

world artist-plugin {
    import host-tools;
    import host-control;
    import host-resources;
    import host-events;
    import host-progress;
    import host-sessions;
    import provider-state;
    import native-filesystem;
    import native-profiles;
    import native-plugins;
    export lifecycle;
    export model-provider;
    export tool-provider;
    export resource-provider;
    export slash-command-provider;
}
