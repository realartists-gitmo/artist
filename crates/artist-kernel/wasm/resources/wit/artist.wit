package artist:resources@1.0.0;

interface types {
    enum kind { directory, file }
    record attrs {
        kind: kind,
        size: u64,
        mtime-secs: u64,
        mtime-nsecs: u32,
    }
    record entry { name: string, kind: kind, size: u64 }
    enum error {
        invalid-address,
        not-found,
        not-dir,
        is-dir,
        io,
        permission-denied,
        unsupported,
        conflict,
    }
}

/// A URI resource provider. The namespace owner decides how overlapping
/// providers compose; the generic master does not impose precedence.
interface provider {
    use types.{attrs, entry, error};
    matches: func(uri: string) -> bool;
    get-attrs: func(uri: string) -> result<attrs, error>;
    readdir: func(uri: string) -> result<list<entry>, error>;
    read: func(uri: string, offset: u64, size: u32) -> result<list<u8>, error>;
    write: func(uri: string, offset: u64, data: list<u8>) -> result<u32, error>;
    move-resource: func(source: string, destination: string) -> result<_, error>;
    delete: func(uri: string) -> result<_, error>;
}

world resource-provider {
    import types;
    export provider;
}
