package artist:composition@1.0.0;

interface types {
    record contribution {
        id: string,
        source: option<string>,
        slot: string,
        order: s64,
        revision: u64,
        content: string,
    }

    record snapshot { contributions: list<contribution> }

    variant event {
        replace(contribution),
        remove(string),
        append(contribution),
    }

    record tool-definition {
        name: string,
        description: option<string>,
        input-schema: string,
    }

    record tool-unavailable {
        name: string,
        reason: option<string>,
    }

    variant tool-event {
        available(tool-definition),
        unavailable(tool-unavailable),
    }

    variant composition-update {
        context(event),
        tool(tool-event),
    }

    record session-input {
        identity: string,
        profile: option<string>,
        profile-resource: option<string>,
        system: option<string>,
        agent-instructions: option<string>,
        profile-content: option<string>,
        visible-resources: list<string>,
        tool-events: list<string>,
    }

    enum error { invalid-input, unavailable, failed }
}

interface extension {
    use types.{error, session-input, snapshot, composition-update};
    initial: func(input: session-input) -> result<snapshot, error>;
    update: func(input: session-input) -> result<list<composition-update>, error>;
}

interface resource-host {
    use types.{error};
    read: func(uri: string) -> result<string, error>;
}

world composition-extension {
    import types;
    import resource-host;
    export extension;
}
