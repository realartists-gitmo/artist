package artist:verbs@1.0.0;

/// The verb contract. A component exporting one or more verb interfaces is a
/// tool: typed operations over resources, file-shaped in, file-shaped out.
///
/// Family shape (locked in `kernel-wasm-scaffold.md`):
///
///   * Every verb exports ONE function taking `list<request>` and returning
///     `list<result<response, error>>` — batch in, batch out.
///   * The model surface stays scalar: the harness batches scalar tool calls
///     into one component call. Batching is never the model's job.
///   * Flat scalar arguments over nested structures.
///   * Homogeneous operations over unions / optional modes / "do one of several
///     things" arguments.
///   * "Boring" shapes are closer to model training. No clever encodings.
///
/// The base package currently defines `read`, `write`, `move`, `edit`, `find`, and `grep`. Further verbs may be
/// added here or in tool extensions' own packages.
interface types {
    enum error {
        invalid-argument,
        not-found,
        unsupported,
        permission-denied,
        conflict,
        aborted,
        internal,
    }
}

interface read {
    use types.{error};

    record request {
        uri: string,
        range: option<string>,
    }

    record line {
        anchor: string,
        content: string,
    }

    record resource-info {
        uri: string,
        mime-type: option<string>,
        size: u64,
    }

    record response {
        uri: string,
        position: option<string>,
        range: string,
        lines: list<line>,
        partial: bool,
        binary: bool,
        mime-type: option<string>,
        resource-ref: option<resource-info>,
    }

    read: func(requests: list<request>) -> list<result<response, error>>;
}

interface write {
    use types.{error};

    record request {
        uri: string,
        content: string,
    }

    record response {
        created: bool,
        replaced: bool,
        bytes-written: u64,
    }

    write: func(requests: list<request>) -> list<result<response, error>>;
}

interface move {
    use types.{error};

    record request {
        source: string,
        destination: option<string>,
    }

    record response {
        source: string,
        destination: option<string>,
        removed: bool,
    }

    execute: func(requests: list<request>) -> list<result<response, error>>;
}

interface edit {
    use types.{error};

    record change {
        anchor: string,
        replacement: string,
    }

    record request {
        uri: string,
        changes: list<change>,
    }

    edit: func(requests: list<request>) -> list<result<_, error>>;
}

interface find {
    use types.{error};

    enum result-kind {
        file,
        directory,
    }

    record request {
        uri: string,
        query: string,
        limit: option<u32>,
        /// One of `literal`, `glob`, or `fuzzy`. If absent, wildcard queries
        /// are treated as glob patterns and other queries as fuzzy search.
        mode: option<string>,
    }

    record match {
        uri: string,
        kind: result-kind,
    }

    record response {
        results: list<match>,
        truncated: bool,
    }

    execute: func(requests: list<request>) -> list<result<response, error>>;
}

interface grep {
    use types.{error};

    record request {
        uri: string,
        query: string,
        limit: option<u32>,
        mode: option<string>,
    }

    record match {
        uri: string,
        anchor: option<string>,
        content: string,
    }

    record response {
        matches: list<match>,
        truncated: bool,
    }

    execute: func(requests: list<request>) -> list<result<response, error>>;
}

interface run {
    use types.{error};

    record request {
        executable: option<string>,
        target: option<string>,
        arguments: list<string>,
        working-directory: option<string>,
        environment: list<environment>,
    }

    record environment {
        name: string,
        value: string,
    }

    record response {
        process: string,
        stdin: string,
        stdout: string,
        stderr: string,
        status: string,
    }

    execute: func(requests: list<request>) -> list<result<response, error>>;
}

interface poll {
    use types.{error};

    record request {
        target: string,
        match: option<string>,
        timeout-ms: u64,
        stdout-offset: option<u64>,
        stderr-offset: option<u64>,
    }

    record chunk {
        stream-name: string,
        offset: u64,
        content: string,
    }

    record response {
        target: string,
        event: string,
        matched: bool,
        content: option<string>,
        stdout-offset: u64,
        stderr-offset: u64,
        chunks: list<chunk>,
    }

    execute: func(requests: list<request>) -> list<result<response, error>>;
}

interface signal {
    use types.{error};

    record request {
        process: string,
        signal: string,
    }

    signal: func(requests: list<request>) -> list<result<_, error>>;
}

/// Generic opaque tool ABI used by the model-facing component registry.
interface tool {
    /// The model-facing component boundary keeps the original diagnostic
    /// instead of reducing every failure to a closed enum. The host turns
    /// this small record into the provider-neutral tool envelope.
    record failure {
        code: string,
        message: string,
        details: option<string>,
    }

    invoke: func(request: list<u8>) -> result<list<u8>, failure>;
}

interface resource-api {
    /// Resource providers return their original diagnostic at the tool
    /// boundary; the component host maps this record without flattening it
    /// into a closed enum.
    record failure {
        code: string,
        message: string,
        details: option<string>,
    }

    enum kind {
        file,
        directory,
    }

    record entry {
        name: string,
        kind: kind,
        size: u64,
    }

    read: func(uri: string, offset: u64, size: u32) -> result<list<u8>, failure>;
    readdir: func(uri: string) -> result<list<entry>, failure>;
    truncate: func(uri: string, size: u64) -> result<_, failure>;
    /// Replace a complete resource atomically when the backing provider can
    /// support that operation.
    replace: func(uri: string, data: list<u8>) -> result<u64, failure>;
    write: func(uri: string, offset: u64, data: list<u8>) -> result<u32, failure>;
    move-resource: func(source: string, destination: string) -> result<_, failure>;
    delete: func(uri: string) -> result<_, failure>;
}

/// Generic dynamic invocation for extensions that want to consume another
/// registered verb. The payload is opaque to the kernel and is interpreted by
/// the caller and target verb according to their shared contract.
interface registry {
    enum error {
        invalid-argument,
        not-found,
        unsupported,
        permission-denied,
        conflict,
        aborted,
        internal,
    }

    invoke: func(name: string, request: list<u8>) -> result<list<u8>, error>;
}

world verbs-extension {
    import types;
    import registry;
    export read;
    export write;
    export move;
    export edit;
    export find;
    export grep;
    export run;
    export poll;
    export signal;
    /// Each verb component receives capability-scoped WASI filesystem
    /// preopens. The component uses ordinary open/read/write/rename/unlink
    /// operations; URI-to-resource routing remains host policy.
    import wasi:filesystem/types@0.3.0;
    import wasi:filesystem/preopens@0.3.0;
}

world tool-extension {
    import types;
    import resource-api;
    export tool;
}
