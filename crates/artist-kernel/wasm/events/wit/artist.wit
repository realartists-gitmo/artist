package artist:events@1.0.0;

/// The event contract. A component exporting `subscriber` is a service:
/// long-lived and reactive. It subscribes to typed events from the kernel
/// broker, reacts to them, and emits events of its own.
///
/// The kernel hosts the broker; the whole harness (agent loop and every
/// extension) publishes to and consumes from the same typed event stream.
interface types {
    /// A typed event on the harness event stream.
    record event {
        topic: string,
        /// Opaque payload. The encoding is determined by the topic; at the
        /// model boundary this is TOON, not JSON.
        payload: string,
        /// Monotonic sequence number assigned by the broker.
        sequence: u64,
    }
}

/// Imported by extensions: the kernel-resident broker.
interface broker {
    enum error {
        invalid-topics,
        no-such-subscription,
    }

    /// Subscribe to `topics`. Returns a subscription handle.
    subscribe: func(topics: list<string>) -> result<u64, error>;

    /// Cancel a subscription.
    unsubscribe: func(subscription: u64) -> result<_, error>;

    /// Emit an event on `topic` with `payload`. The broker assigns the
    /// sequence number and fans out to every subscriber of that topic.
    emit: func(topic: string, payload: string) -> result<_, error>;
}

/// Exported by extensions: the broker pushes subscribed events here.
interface subscriber {
    use types.{event};

    enum error {
        handler-failed,
    }

    /// Handle one delivered event. Returning an error is treated as a
    /// subscriber failure but does not abort the broker's fan-out.
    handle-event: func(event: event) -> result<_, error>;
}

world events-extension {
    import types;
    import broker;
    export subscriber;
}