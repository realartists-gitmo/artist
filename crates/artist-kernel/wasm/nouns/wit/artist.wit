package artist:nouns@2.0.0;

interface types {
    enum kind { directory, file }
    record attrs {
        kind: kind,
        size: u64,
        mtime-secs: u64,
        mtime-nsecs: u32,
    }
    record entry { name: string, kind: kind, size: u64 }
    enum error {
        not-found,
        not-dir,
        is-dir,
        io,
        permission-denied,
        unsupported,
    }
}

/// Host resource access for nouns that derive or decorate another resource.
interface resource-host {
    use types.{attrs, entry, error};
    get-attrs: func(uri: string) -> result<attrs, error>;
    readdir: func(uri: string) -> result<list<entry>, error>;
    read: func(uri: string, offset: u64, size: u32) -> result<list<u8>, error>;
}

/// URI-aware noun provider. `matches` receives the complete canonical URI and
/// may route on any URI behavior: scheme, authority, path, suffix, query, or
/// fragment. It is not a prefix claim and may overlap other providers.
interface provider {
    use types.{attrs, entry, error};
    matches: func(uri: string) -> bool;
    getattr: func(uri: string) -> result<attrs, error>;
    readdir: func(uri: string) -> result<list<entry>, error>;
    read: func(uri: string, offset: u64, size: u32) -> result<list<u8>, error>;
}

world nouns-extension {
    import types;
    import resource-host;
    export provider;
}
