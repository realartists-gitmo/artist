package artist:tool@1.0.0;
interface read {
    use artist:%resource/types@1.0.0.{anchored-text, error, position, uri};
    record read-request { uri: uri, at: option<position>, before: option<u32>, after: option<u32> }
    record directory-result { uri: uri, entries: list<uri> }
    variant read-response { text(anchored-text), directory(directory-result) }
    read: func(requests: list<read-request>) -> list<result<read-response, error>>;
    observe: func(response: result<read-response, error>) -> string;
}
world tool-world { export read; }
