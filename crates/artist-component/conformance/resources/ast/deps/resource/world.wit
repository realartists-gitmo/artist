package artist:%resource@1.0.0;

interface types {
    type uri = string;
    type anchor = string;
    enum line-ending { none, lf, crlf, cr }
    record anchored-line { anchor: anchor, text: string, ending: line-ending }
    record anchored-text { uri: uri, lines: list<anchored-line> }
    variant position { top, bottom, at(anchor) }
    enum error-code { invalid-uri, invalid-input, internal }
    record error { code: error-code, uri: option<uri>, message: string }
    record read-request { uri: uri, at: option<position>, before: option<u32>, after: option<u32> }
    variant read-result { text(anchored-text) }
    enum claim-decision { pass, handle, reserve }
    type verb-id = string;
    record claim-request { verb: verb-id, uri: uri }
}

interface filesystem {
    is-file: func(uri: string) -> bool;
}

interface extension {
    use types.{claim-request, claim-decision};
    claim: func(request: claim-request) -> claim-decision;
}
