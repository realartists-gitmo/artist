+            expected: Vec<&'a str>,
+        }
+
+        let cases = [
+            Case {
+                behavior: SplitDelimiterBehavior::MergedWithPrevious,
+                input: "hello world foo",
+                expected: ["hello ", "world ", "foo"].into(),
+            },
+            // A leading delimiter has no previous chunk, so it stands alone
+            // rather than being dropped.
+            Case {
+                behavior: SplitDelimiterBehavior::MergedWithPrevious,
+                input: " leading",
+                expected: [" ", "leading"].into(),
+            },
+            Case {
+                behavior: SplitDelimiterBehavior::MergedWithPrevious,
+                input: "trailing ",
+                expected: ["trailing "].into(),
+            },
+            Case {
+                behavior: SplitDelimiterBehavior::MergedWithNext,
+                input: "hello world foo",
+                expected: ["hello", " world", " foo"].into(),
+            },
+            // A trailing delimiter has no following chunk to join.
+            Case {
+                behavior: SplitDelimiterBehavior::MergedWithNext,
+                input: "trailing ",
+                expected: ["trailing", " "].into(),
+            },
+            // Adjacent delimiters fold into one chunk.
+            Case {
+                behavior: SplitDelimiterBehavior::Contiguous,
+                input: "a  b",
+                expected: ["a", "  ", "b"].into(),
+            },
+            Case {
+                behavior: SplitDelimiterBehavior::Isolate,
+                input: "a  b",
+                expected: ["a", " ", " ", "b"].into(),
+            },
+            Case {
+                behavior: SplitDelimiterBehavior::Remove,
+                input: "a  b",
+                expected: ["a", "b"].into(),
+            },
+        ];
+
+        cases.test_each(|case| {
+            let split = Split::new(SplitOptions {
+                pattern: " ",
+                delimiter: case.behavior,
+                invert: false,
+            })
+            .unwrap();
+            assert_eq!(split.pre_tokenize(case.input).unwrap(), case.expected);
+        });
+    }
